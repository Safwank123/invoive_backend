# Example environment variables for local development and reference.
# DO NOT commit real secrets. Copy this to `.env` and fill values locally.

SECRET_KEY=replace-me-with-your-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Example Postgres URL: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Gunicorn workers (optional)
GUNICORN_WORKERS=3

# Storage and Email (examples)
#DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_STORAGE_BUCKET_NAME=
SECRET_KEY=replace-this-with-a-secure-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend-url.com
CORS_ALLOW_ALL_ORIGINS=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-strong-password
DATABASE_URL=postgres://db_user:db_password@db_host:5432/db_name
